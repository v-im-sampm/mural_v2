diff --git a/platformio.ini b/platformio.ini
index 47aa8c6..b3091c4 100644
--- a/platformio.ini
+++ b/platformio.ini
@@ -25,3 +25,9 @@ lib_deps =
 	https://github.com/teemuatlut/tmcstepper.git@0.7.3+sha.74e8e68
 	waspinator/AccelStepper@^1.64
 	bblanchon/ArduinoJson@^5.13.4
+
+; ESP32 "Arduino Uno" board (Wemos D1 R32 and clones) + Arduino CNC Shield V3.
+; Pin map: src/board.h. Build/flash: pio run -e d1r32 -t upload && pio run -e d1r32 -t uploadfs
+[env:d1r32]
+extends = env:esp32dev
+build_flags = -DMURAL_BOARD_D1_R32
diff --git a/src/board.h b/src/board.h
new file mode 100644
index 0000000..9c640bb
--- /dev/null
+++ b/src/board.h
@@ -0,0 +1,38 @@
+#ifndef Board_h
+#define Board_h
+
+// Pin map for the board Mural runs on. Select with a build flag in platformio.ini.
+
+#if defined(MURAL_BOARD_D1_R32)
+// ESP32 "Arduino Uno" board (Wemos D1 R32 and clones) + CNC Shield V3.
+// Uno header -> ESP32 GPIO on the D1 R32:
+//   D2=26 D3=25 D4=17 D5=16 D6=27 D7=14 D8=12 D9=13 D10=5 D11=23 D12=19 D13=18
+constexpr int BOARD_LEFT_STEP_PIN = 26;   // X.STEP (D2)
+constexpr int BOARD_LEFT_DIR_PIN = 16;    // X.DIR  (D5)
+constexpr int BOARD_RIGHT_STEP_PIN = 25;  // Y.STEP (D3)
+constexpr int BOARD_RIGHT_DIR_PIN = 27;   // Y.DIR  (D6)
+constexpr int BOARD_MOTOR_ENABLE_PIN = 12; // EN    (D8)
+constexpr bool BOARD_HAS_TMC_UART = false; // the shield doesn't wire driver UART; use jumpers + Vref
+constexpr bool BOARD_INVERT_LEFT = true;   // flip if "retract" unwinds the belt
+constexpr bool BOARD_INVERT_RIGHT = false;
+constexpr int BOARD_SERVO_PIN = 13;        // X+/X- end-stop header (D9)
+constexpr int BOARD_OLED_SDA = 17;         // Z driver socket STEP pin (D4) - leave the Z socket empty
+constexpr int BOARD_OLED_SCL = 14;         // Z driver socket DIR pin (D7)
+// SD card (SPI) uses the stock pins, which land on the shield's headers:
+//   CS=5 (Y end-stop, D10), MOSI=23 (Z end-stop, D11), MISO=19 (SpnEn, D12), SCK=18 (SpnDir, D13)
+#else
+// Stock Mural v2: TMC2209 Pen/Laser FluidNC controller.
+constexpr int BOARD_LEFT_STEP_PIN = 14;
+constexpr int BOARD_LEFT_DIR_PIN = 12;
+constexpr int BOARD_RIGHT_STEP_PIN = 25;
+constexpr int BOARD_RIGHT_DIR_PIN = 26;
+constexpr int BOARD_MOTOR_ENABLE_PIN = 13;
+constexpr bool BOARD_HAS_TMC_UART = true;
+constexpr bool BOARD_INVERT_LEFT = true;
+constexpr bool BOARD_INVERT_RIGHT = false;
+constexpr int BOARD_SERVO_PIN = 21;
+constexpr int BOARD_OLED_SDA = 15;
+constexpr int BOARD_OLED_SCL = 4;
+#endif
+
+#endif
